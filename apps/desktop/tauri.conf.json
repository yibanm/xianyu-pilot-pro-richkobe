{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xianyu-pilot-pro",
  "version": "1.0.0",
  "identifier": "com.richkobe.xianyupilotpro",
  "build": {
    "frontendDist": "frontend-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "resources": {
      "payload/runtime": "runtime",
      "payload/app": "app"
    }
  }
}
